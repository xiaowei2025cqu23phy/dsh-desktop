{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面端:内嵌 Web UI、AI 屏保模式(替换系统屏保)、全模型快捷切换。",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "smoke": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --win zip",
    "pack:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness Desktop",
    "files": [
      "dist/main/**",
      "dist/preload.js",
      "dist/renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  }
}
