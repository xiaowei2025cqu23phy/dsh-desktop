/**
 * 远程 PWA 渲染层类型检查配置。
 * 源文件 src/remote/app.ts,经 esbuild 打包为单文件 dist/remote/app.js(IIFE)。
 * 类型检查从宽松起步:先保证变量/类型明显错误被捕获,再逐步收紧(strict)。
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/remote/app.ts"]
}
